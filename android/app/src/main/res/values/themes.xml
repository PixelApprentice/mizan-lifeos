<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default; values-night/ switches to the black theme when the phone is in dark mode.
         The WebView reads this to answer prefers-color-scheme for the companion page. -->
    <style name="Theme.Mizan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mizan_bg</item>
        <item name="android:statusBarColor">@color/mizan_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
